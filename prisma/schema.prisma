model Appointment {
  id             String            @id @default(cuid())
  clientId       String
  therapistId    String
  date           DateTime
  duration       Int               @default(50)
  type           AppointmentType   @default(video)
  status         AppointmentStatus @default(pending)
  notes          String?
  isNew          Boolean           @default(false)
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  therapist      Therapist         @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Cascade)
  videoSession   VideoSession?
  videoSignals   VideoSignal[]
  sessionCredit  ClientSessionCredit?
  sessionCharge  SessionCharge?

  @@index([clientId, date])
  @@index([therapistId, date])
}

// Real per-session payment ledger for client-initiated 1-on-1 bookings. onDelete: Cascade
// (not Restrict) — the protection against a casual therapist hard-delete destroying a live
// charge is an API-layer 409 guard (DELETE /api/appointments/[id]), not the FK, since a
// Restrict FK would also break self-service account deletion relying on cascade.
model SessionCharge {
  id                    String                      @id @default(cuid())
  appointmentId         String                      @unique
  clientId              String
  therapistId           String
  amountCents           Int
  currency              String
  platformFeeBps        Int
  platformFeeCents      Int
  therapistAmountCents  Int
  fundingSource         SessionChargeFundingSource  @default(card)
  status                SessionChargeStatus         @default(requires_payment)
  outcomeReason         SessionChargeOutcomeReason?
  stripeCheckoutSessionId String?                   @unique
  stripePaymentIntentId String?                     @unique
  stripeRefundId        String?                     @unique
  // Not @unique — a single batched payout Transfer can legitimately settle multiple
  // SessionCharge rows at once (only a standalone forfeiture Transfer is ever 1:1).
  stripeTransferId      String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  appointment           Appointment                 @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client                User                        @relation("ClientSessionCharges", fields: [clientId], references: [id], onDelete: Cascade)
  therapist              Therapist                  @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, createdAt])
  @@index([clientId, createdAt])
}

enum SessionChargeFundingSource {
  card
  premium_credit
}

// Two real terminal states (refunded to client, or transferred to therapist) plus the
// pre-terminal requires_payment/failed states — outcomeReason separately records *why*,
// since completion/early-cancel/late-cancel/no-show only ever resolve to one of those two
// money movements, not four genuinely different terminal states.
enum SessionChargeStatus {
  requires_payment
  paid
  refunded
  transferred
  failed
}

enum SessionChargeOutcomeReason {
  completed
  early_cancellation
  late_cancellation
  no_show
}

