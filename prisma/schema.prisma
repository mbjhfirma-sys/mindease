generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                        @id @default(cuid())
  email                        String                        @unique
  name                         String
  password                     String
  role                         Role                          @default(CLIENT)
  avatar                       String?
  plan                         String                        @default("free")
  phone                        String?
  dob                          DateTime?
  timezone                     String                        @default("UTC")
  language                     String                        @default("en")
  xp                           Int                           @default(0)
  level                        Int                           @default(1)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  therapistId                  String?
  clientCode                   String?                       @unique
  notificationPrefs            Json?
  privacyPrefs                 Json?
  communityContentOnDeletion   CommunityContentDeletionMode  @default(delete)
  dataDirective                Json?
  stripeCustomerId             String?                       @unique
  twoFactorEnabled             Boolean                       @default(false)
  twoFactorSecret              String?
  twoFactorFailedAttempts      Int                           @default(0)
  twoFactorLockedUntil         DateTime?
  hasOnboarded                 Boolean                       @default(false)
  hasSeenClientTour            Boolean                       @default(true)
  loginStreak                  Int                           @default(0)
  lastActiveDay                String?
  peerMatchingOptIn            Boolean                       @default(false)
  lastDailyReminderSentAt      DateTime?
  lastMissionReminderSentAt    DateTime?
  lastMoodReminderSentAt       DateTime?
  lastWeeklyDigestSentAt       DateTime?
  achievements                 Achievement[]
  communityReports             CommunityReport[]
  clientAppointments           Appointment[]                 @relation("ClientAppointments")
  assessmentResults            AssessmentResult[]
  communityPosts               CommunityPost[]
  clientConversations          Conversation[]                @relation("ClientConversations")
  courseProgress               CourseProgress[]
  articleProgress              ArticleProgress[]
  groupMemberships             GroupMembership[]
  journalEntries               JournalEntry[]
  sentMessages                 Message[]
  missionCompletions           MissionCompletion[]
  moodEntries                  MoodEntry[]
  notifications                Notification[]
  postLikes                    PostLike[]
  postReplies                  PostReply[]                   @relation("PostReplyAuthor")
  therapistProfile             Therapist?                    @relation("TherapistUser")
  therapistGroupInvites        TherapistGroupInvite[]        @relation("TherapistGroupInviteUser")
  therapistGroupMemberships    TherapistGroupMembership[]    @relation("TherapistGroupMemberUser")
  therapistGroupPosts          TherapistGroupPost[]          @relation("TherapistGroupPostAuthor")
  therapistGroupPostLikes      TherapistGroupPostLike[]      @relation("TherapistGroupPostLikeUser")
  therapistGroupPostReplies    TherapistGroupPostReply[]     @relation("TherapistGroupPostReplyAuthor")
  receivedMissions             MissionAssignment[]           @relation("ClientMissionAssignments")
  assignedTherapist            Therapist?                    @relation("TherapistClients", fields: [therapistId], references: [id], onDelete: SetNull)
  clinicalNotes                ClinicalNote[]                @relation("ClientClinicalNotes")
  treatmentPlans               TreatmentPlan[]               @relation("ClientTreatmentPlans")
  courseEnrollments            CourseEnrollment[]            @relation("ClientCourseEnrollments")
  therapistGroupPostReplyLikes TherapistGroupPostReplyLike[] @relation("TherapistGroupPostReplyLikeUser")
  challengeParticipations      ChallengeParticipant[]
  adminAuditLogs               AdminAuditLog[]
  safetyPlan                   SafetyPlan?
  riskFlags                    RiskFlag[]
  riskStepUpWindows            RiskStepUpWindow[]
  stepUpContactFor             RiskStepUpWindow[] @relation("StepUpContact")
  waitlistEntries              WaitlistEntry[]
  backupCodes                  BackupCode[]
  clientIntake                 ClientIntake?
  dailyBriefings               DailyBriefing[]
  weeklyDigestsAsClient        WeeklyDigest[]                @relation("ClientWeeklyDigests")
  mindoChatMessages            MindoChatMessage[]
  clientSessionEarnings        SessionEarning[]
  couponRedemption             CouponRedemption?
  courseRecommendation         CourseRecommendation?
  matchReasoning                MatchReasoning?
  matchFeedbackAsClient         MatchFeedback[]                @relation("MatchFeedbackClient")
  matchFeedbackAsRespondent     MatchFeedback[]                @relation("MatchFeedbackRespondent")
  hostedGroupSessions           GroupSession[]                 @relation("GroupSessionHost")
  groupSessionRsvps             GroupSessionRsvp[]
  groupSessionParticipations    GroupSessionParticipant[]
  clientSubscription            ClientSubscription?
  sessionCharges                SessionCharge[]                @relation("ClientSessionCharges")
}

model Therapist {
  id                  String                      @id @default(cuid())
  userId              String                      @unique
  title               String
  specializations     String[]
  bio                 String?
  approach            String?
  yearsOfExperience   Int?
  education           String[]                    @default([])
  languages           String[]                    @default([])
  licenseNumber       String?
  rating              Float                       @default(0)
  totalSessions       Int                         @default(0)
  activeClients       Int                         @default(0)
  pendingAppointments Int                         @default(0)
  pendingMessages     Int                         @default(0)
  verificationStatus  TherapistVerificationStatus @default(pending)
  verifiedAt          DateTime?
  maxClients          Int?
  professionType      ProfessionType?
  gender              String?
  profileCompleted    Boolean                     @default(true)
  ageGroupsServed     String[]                    @default([])
  modalities          String[]                    @default([])
  affirmingCareTags   String[]                    @default([])
  mindoDigestsEnabled Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  appointments        Appointment[]               @relation("TherapistAppointments")
  conversations       Conversation[]              @relation("TherapistConversations")
  missions            Mission[]
  user                User                        @relation("TherapistUser", fields: [userId], references: [id], onDelete: Cascade)
  groups              TherapistGroup[]
  clients             User[]                      @relation("TherapistClients")
  clinicalNotes       ClinicalNote[]
  treatmentPlans      TreatmentPlan[]
  courseEnrollments   CourseEnrollment[]
  availabilitySlots   AvailabilitySlot[]
  waitlistEntries     WaitlistEntry[]
  weeklyDigests       WeeklyDigest[]
  billing             TherapistBilling?
  sessionEarnings     SessionEarning[]
  payouts             Payout[]
  subscription        TherapistSubscription?
  coupons             Coupon[]
  affiliateCommissions AffiliateCommission[]
  clinicOwned          Clinic?
  clinicMemberships    ClinicMembership[]
  matchReasonings      MatchReasoning[]
  matchFeedback        MatchFeedback[]
  sessionCharges       SessionCharge[]
}

// Rate configuration for a therapist's video-session earnings, plus the billing-identity/
// notification settings surfaced on the Subscription tab. No SessionEarning rows are created
// for a therapist until ratePerMinuteCents is set — never fabricate a rate.
model TherapistBilling {
  id                           String    @id @default(cuid())
  therapistId                  String    @unique
  ratePerMinuteCents           Int?
  currency                     String    @default("USD")
  // Basis points YouMindo keeps of each session; 0 = therapist keeps 100%. Business decision
  // TBD — documented default, trivially adjustable later without a schema change.
  platformFeeBps               Int       @default(0)
  billingEmail                 String?
  invoiceCompanyName           String?
  vatNumber                    String?
  paymentNotificationsEnabled  Boolean   @default(true)
  // Stripe Connect Express account for real per-session payouts. The three booleans mirror
  // Stripe's own Account object fields 1:1 — written only by the account.updated webhook,
  // never by any therapist-facing route (same "can't self-serve platform terms" principle
  // already applied to platformFeeBps).
  stripeConnectAccountId        String?   @unique
  stripeConnectChargesEnabled   Boolean   @default(false)
  stripeConnectPayoutsEnabled   Boolean   @default(false)
  stripeConnectDetailsSubmitted Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  therapist                    Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
}

// Dedup ledger for inbound Stripe webhook events. Uses create-and-catch-P2002, not the
// upsert-with-no-op-update idiom Invoice uses below — that idiom makes a *value write*
// idempotent, but here the row's existence is what gates whether side effects (a transfer,
// a notification) run at all, so a silent no-op on retry would be the bug, not the fix.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

// A therapist's own paid plan with YouMindo (platform SaaS subscription) — separate from,
// and unrelated to, the still-mock client-side subscription elsewhere in this app.
model TherapistSubscription {
  id                 String             @id @default(cuid())
  therapistId        String             @unique
  planId             String
  priceCents         Int
  currency           String             @default("USD")
  billingCycle       BillingCycle       @default(monthly)
  autoRenew          Boolean            @default(true)
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  therapist          Therapist          @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
}

// One row per elapsed billing period, created by reconciliation (lib/subscriptionBilling.ts)
// rather than up front, so numbers only ever reflect genuinely elapsed time.
model Invoice {
  id             String                @id @default(cuid())
  subscriptionId String
  therapistId    String
  periodStart    DateTime
  periodEnd      DateTime
  amountCents    Int
  currency       String
  status         InvoiceStatus         @default(paid)
  issuedAt       DateTime              @default(now())
  subscription   TherapistSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  commission     AffiliateCommission?

  @@unique([subscriptionId, periodStart])
  @@index([therapistId, issuedAt])
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionStatus {
  active
  canceled
}

enum InvoiceStatus {
  paid
  pending
  failed
}

// A client's real Free/Growth/Premium subscription. No row at all while on Free — same
// lazy-creation instinct as TherapistBilling/TherapistSubscription. currentPeriodStart/End
// are a passive mirror of whatever Stripe last reported, written only by the webhook
// handler — unlike TherapistSubscription's local reconcileSubscription math, which only
// exists because that side has no real processor behind it yet.
model ClientSubscription {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  planId               String
  priceCents           Int
  currency             String                   @default("USD")
  status               ClientSubscriptionStatus @default(active)
  stripeSubscriptionId String                   @unique
  stripePriceId        String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean                  @default(false)
  canceledAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionCredits       ClientSessionCredit[]
}

enum ClientSubscriptionStatus {
  active
  past_due
  canceled
  incomplete
}

// A Premium client's one free 15-min session/month. The row's existence is the claim (no
// usedAt flag) — created via `create`, caught on P2002 if the period's slot is already
// taken. Releasing a credit on an eligible early cancellation is just deleting the row.
model ClientSessionCredit {
  id                   String             @id @default(cuid())
  clientSubscriptionId String
  periodStart          DateTime
  appointmentId        String             @unique
  createdAt            DateTime           @default(now())
  clientSubscription   ClientSubscription @relation(fields: [clientSubscriptionId], references: [id], onDelete: Cascade)
  appointment          Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([clientSubscriptionId, periodStart])
}

// Session earnings ledger — one row per completed appointment, created once, snapshotting the
// rate/fee at that moment so later rate changes never retroactively rewrite history.
model SessionEarning {
  id                 String         @id @default(cuid())
  appointmentId      String         @unique
  therapistId        String
  clientId           String
  sessionDate        DateTime
  durationMinutes    Float
  durationSource     DurationSource
  ratePerMinuteCents Int
  grossAmountCents   Int
  platformFeeBps     Int
  platformFeeCents   Int
  netAmountCents     Int
  currency           String
  payoutId           String?
  createdAt          DateTime       @default(now())
  therapist          Therapist      @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  client             User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payout             Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([therapistId, sessionDate])
  @@index([payoutId])
}

// A withdrawal batch. "paid" is manually-tracked bookkeeping (no real bank transfer yet) — a
// therapist marks it paid once reconciled themselves, mirroring the existing "we don't process
// payments directly" precedent already used elsewhere in this app.
model Payout {
  id               String                 @id @default(cuid())
  therapistId      String
  status           PayoutStatus           @default(pending)
  totalAmountCents Int
  currency         String
  note             String?
  createdAt        DateTime               @default(now())
  paidAt           DateTime?
  therapist        Therapist              @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  earnings         SessionEarning[]
  commissions      AffiliateCommission[]
}

// A therapist's own referral/discount code. Doubles as both the affiliate-tracking mechanism
// (who they referred) and a real discount for the referred signup — one unified system rather
// than two separate features.
model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  ownerTherapistId String
  discountType     DiscountType
  discountValue    Int
  // Basis points of a referred therapist's own subscription invoice paid to the coupon owner
  // as commission. Only ever applies to THERAPIST-role redemptions — see AffiliateCommission.
  commissionBps    Int                @default(1000)
  active           Boolean            @default(true)
  maxRedemptions   Int?
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            Therapist          @relation(fields: [ownerTherapistId], references: [id], onDelete: Cascade)
  redemptions      CouponRedemption[]

  @@index([ownerTherapistId])
}

// One redeemed coupon per account, captured at signup — @@unique enforces "at most one
// coupon per user, ever" at the database level.
model CouponRedemption {
  id                    String    @id @default(cuid())
  couponId              String
  redeemedByUserId      String    @unique
  redeemedRole          Role
  discountValueSnapshot Int
  redeemedAt            DateTime  @default(now())
  coupon                Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  redeemedBy            User      @relation(fields: [redeemedByUserId], references: [id], onDelete: Cascade)
  commissions           AffiliateCommission[]

  @@index([couponId])
}

// Accrues once per elapsed billing period on the REFERRED THERAPIST'S OWN subscription — a
// single referral earns commission on every period they stay subscribed, not just once.
// invoiceId is unique (one commission per invoice, preventing double-accrual on reconciliation
// retries); redemptionId is deliberately NOT unique, since one redemption spans many invoices
// over time. Never accrues off the still-mock client subscription, which has no real revenue
// behind it to share — client-role redemptions record a discount fact only, no commission.
model AffiliateCommission {
  id               String           @id @default(cuid())
  redemptionId     String
  invoiceId        String           @unique
  ownerTherapistId String
  amountCents      Int
  currency         String
  status           CommissionStatus @default(accrued)
  accruedAt        DateTime         @default(now())
  payoutId         String?
  redemption       CouponRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  owner            Therapist        @relation(fields: [ownerTherapistId], references: [id], onDelete: Cascade)
  payout           Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([ownerTherapistId, accruedAt])
  @@index([payoutId])
}

enum DiscountType {
  percent
  fixed
}

enum CommissionStatus {
  accrued
  paid
}

enum DurationSource {
  actual
  scheduled_fallback
}

enum PayoutStatus {
  pending
  paid
}

// A clinic groups multiple therapists under one owner for seat-based billing. No existing
// Clinic/Organization concept predates this — introduced fresh for Team Billing.
model Clinic {
  id                  String             @id @default(cuid())
  name                String
  ownerTherapistId    String             @unique
  includedSeats       Int                @default(1)
  // Cost per seat beyond includedSeats. Business decision TBD — documented default, trivially
  // adjustable later without a schema change.
  extraSeatPriceCents Int                @default(0)
  currency            String             @default("USD")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               Therapist          @relation(fields: [ownerTherapistId], references: [id], onDelete: Cascade)
  memberships         ClinicMembership[]
}

// One-active-membership-per-therapist isn't expressible as a clean Prisma constraint (would
// need a partial unique index) — enforced at the API layer instead, by rejecting a new invite
// if the invitee already has an invited/active row anywhere.
model ClinicMembership {
  id          String                 @id @default(cuid())
  clinicId    String
  therapistId String
  role        ClinicRole             @default(member)
  status      ClinicMembershipStatus @default(invited)
  invitedAt   DateTime               @default(now())
  joinedAt    DateTime?
  removedAt   DateTime?
  clinic      Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  therapist   Therapist              @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([clinicId, therapistId])
  @@index([therapistId, status])
}

enum ClinicRole {
  owner
  member
}

enum ClinicMembershipStatus {
  invited
  active
  removed
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  label     String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  title        String
  content      String
  mood         Int
  emotions     String[]
  sleepQuality Int?
  triggers     String[] @default([])
  wordCount    Int      @default(0)
  type         String   @default("text")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Course {
  id          String           @id @default(cuid())
  title       String
  instructor  String
  category    String
  level       String           @default("Beginner")
  tags        String[]         @default([])
  enrolled    Int              @default(0)
  description String?
  duration    String?
  lessonCount Int              @default(0)
  rating      Float            @default(0)
  thumbnail   String?
  color       String?
  published   Boolean          @default(true)
  // Admin-flagged: visible/enrollable on the Free plan even without the full-library
  // entitlement. A course-level flag, not a lesson-count cap — simpler to enforce.
  isFreeTier  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lessons     Lesson[]
  progress    CourseProgress[]
  recommendations CourseRecommendation[]
  enrollments CourseEnrollment[]
}

model Lesson {
  id           String           @id @default(cuid())
  courseId     String
  module       String
  order        Int
  title        String
  type         LessonType
  duration     String           @default("5 min")
  content      String?
  videoUrl     String?
  audioUrl     String?
  exerciseType String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  progress     CourseProgress[]

  @@index([courseId, order])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  lessonId    String
  order       Int
  question    String
  options     String[]
  correct     Int
  explanation String   @default("")
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
}

model CourseProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  completed Boolean  @default(false)
  score     Int?
  passed    Boolean?
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonId])
  @@index([userId, courseId])
}

// Mindo's cached "recommended for you" course pick, generated once from the client's
// onboarding concerns/goals (see lib/mindo/ensureCourseRecommendation.ts). Course
// selection is always deterministic keyword-matching (lib/courseRecommendations.ts) —
// only the one-sentence "reason" copy is AI-generated, so there's no risk of Mindo
// recommending a course that doesn't exist.
model CourseRecommendation {
  id        String   @id @default(cuid())
  userId    String   @unique
  courseId  String
  concern   String
  reason    String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Article {
  id        String            @id @default(cuid())
  slug      String            @unique
  title     String
  category  String
  summary   String
  readTime  String            @default("5 min")
  icon      String            @default("📄")
  color     String            @default("bg-sage-100")
  tags      String[]          @default([])
  published Boolean           @default(true)
  order     Int               @default(0)
  blocks    Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  progress  ArticleProgress[]

  @@index([category])
}

model ArticleProgress {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  completed Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}

model AssessmentResult {
  id            String   @id @default(cuid())
  userId        String
  assessmentId  String
  score         Int
  label         String
  answers       Json
  safetyFlagged Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId])
}

model SafetyPlan {
  id                   String   @id @default(cuid())
  userId               String   @unique
  warningSigns         String[] @default([])
  copingStrategies     String[] @default([])
  distractionContacts  Json     @default("[]")
  supportContacts      Json     @default("[]")
  professionalContacts Json     @default("[]")
  safeEnvironmentSteps String[] @default([])
  sharedWithTherapist  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiskFlag {
  id               String    @id @default(cuid())
  userId           String
  source           String
  sourceId         String
  severity         String
  detail           String
  status           String    @default("open")
  acknowledgedAt   DateTime?
  acknowledgedById String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepUpWindows    RiskStepUpWindow[]

  @@index([userId, status])
}

// One active elevated-monitoring window per client, opened when their highest-severity
// RiskFlag fires. No @@unique enforcing "one active window per user" — Prisma can't express
// a partial/conditional unique index, so (mirroring ClinicMembership's identical documented
// tradeoff) this is enforced at the API/cron layer instead via a findFirst-then-create check.
model RiskStepUpWindow {
  id                        String           @id @default(cuid())
  userId                    String
  triggerFlagId             String
  status                     RiskStepUpStatus @default(active)
  // Snapshotted assigned-therapist User.id; null = no therapist, admin team is the contact.
  contactUserId              String?
  // e.g. "Sarah Chen, LMFT" or "MindEase Clinical Team" — snapshotted display label.
  contactLabel                String
  windowStart                 DateTime         @default(now())
  // Stored explicitly (not recomputed) so a later constant change never retroactively
  // shifts already-open windows.
  windowEnd                   DateTime
  checkInIntervalHrs          Int              @default(48)
  lastContactPingAt           DateTime?
  contactPingCount            Int              @default(0)
  // One-time: set once unacknowledged pings cross the admin-escalation threshold.
  escalatedToAdminsAt         DateTime?
  lastClientActivityCheckAt   DateTime?
  missedClientCheckIns        Int              @default(0)
  resolvedAt                  DateTime?
  resolvedById                String?
  createdAt                   DateTime         @default(now())
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerFlag                 RiskFlag         @relation(fields: [triggerFlagId], references: [id], onDelete: Cascade)
  contactUser                 User?            @relation("StepUpContact", fields: [contactUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, windowEnd])
}

enum RiskStepUpStatus {
  active
  resolved
  expired
}

model Mission {
  id           String              @id @default(cuid())
  title        String
  description  String
  category     String
  duration     Int
  xp           Int                 @default(10)
  recurring    Boolean             @default(true)
  activityType String              @default("generic")
  therapistId  String?
  createdAt    DateTime            @default(now())
  therapist    Therapist?          @relation(fields: [therapistId], references: [id], onDelete: SetNull)
  completions  MissionCompletion[]
  assignments  MissionAssignment[]
  attachments  MissionAttachment[]

  @@index([therapistId])
}

model MissionAttachment {
  id        String   @id @default(cuid())
  missionId String
  name      String
  size      Int
  mimeType  String
  url       String
  createdAt DateTime @default(now())
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

model MissionAssignment {
  id         String   @id @default(cuid())
  missionId  String
  clientId   String
  assignedAt DateTime @default(now())
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  client     User     @relation("ClientMissionAssignments", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([missionId, clientId])
  @@index([clientId])
}

model MissionCompletion {
  id           String   @id @default(cuid())
  userId       String
  missionId    String
  completedAt  DateTime @default(now())
  responseData Json?
  mission      Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, missionId, completedAt])
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model DailyBriefing {
  id            String   @id @default(cuid())
  userId        String
  date          String
  briefingText  String
  facts         Json
  model         String
  promptVersion Int      @default(1)
  softened      Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, createdAt])
}

model WeeklyDigest {
  id              String    @id @default(cuid())
  clientId        String
  therapistId     String
  weekStart       String
  digestText      String
  facts           Json
  model           String
  promptVersion   Int       @default(1)
  journalIncluded Boolean   @default(false)
  createdAt       DateTime  @default(now())
  client          User      @relation("ClientWeeklyDigests", fields: [clientId], references: [id], onDelete: Cascade)
  therapist       Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([clientId, therapistId, weekStart])
  @@index([therapistId, createdAt])
  @@index([clientId, createdAt])
}

model MindoChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
