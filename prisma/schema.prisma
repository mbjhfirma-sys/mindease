// A point-in-time snapshot of why a client matched with a therapist — not a history log.
// clientId is @unique, so a rematch simply overwrites the row, matching this codebase's
// existing "current state only" convention for User.therapistId itself. factors stores a
// MatchReasonFactor[] (see lib/matching.ts) — every scoring branch that was applicable at
// match time, including zero/negative-weight ones, for full transparency rather than
// cherry-picked positives.
model MatchReasoning {
  id          String      @id @default(cuid())
  clientId    String      @unique
  therapistId String
  method      MatchMethod
  totalScore  Int
  factors     Json
  createdAt   DateTime    @default(now())
  client      User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist   Therapist   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
}

enum MatchMethod {
  auto
  self_service
  waitlist_accept
}

// Two rows are created per match (one per respondentId — the client, and the therapist's own
// User.id) so client and therapist fit-feedback are independently trackable. respondentId is
// deliberately a User.id even for the therapist side (not a Therapist.id), so it's directly
// comparable to session.user.id at the API layer without an extra lookup.
model MatchFeedback {
  id             String              @id @default(cuid())
  clientId       String
  therapistId    String
  respondentId   String
  respondentRole Role
  status         MatchFeedbackStatus @default(pending)
  rating         Int?
  wouldRecommend Boolean?
  comment        String?
  promptedAt     DateTime            @default(now())
  respondedAt    DateTime?
  client         User                @relation("MatchFeedbackClient", fields: [clientId], references: [id], onDelete: Cascade)
  therapist      Therapist           @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  respondent     User                @relation("MatchFeedbackRespondent", fields: [respondentId], references: [id], onDelete: Cascade)

  @@unique([clientId, therapistId, respondentId])
  @@index([respondentId, status])
}

enum MatchFeedbackStatus {
  pending
  submitted
  skipped
}

